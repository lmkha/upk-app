@echo off
rem Sets up one environment from secrets\<name>\, the folder handed out by the
rem project owner (git-ignored):
rem   - writes secrets.properties: ENVIRONMENT=<name>, then secrets\<name>\secrets.properties
rem   - copies google-services.json as it is
rem The folder name is the only source of ENVIRONMENT, so the files in secrets\
rem must not define it.
rem
rem Usage, with dev, staging or prod:
rem   scripts\use-env.bat dev
rem
rem macOS and Linux use use-env.sh. Keep the two scripts in sync.

setlocal

cd /d "%~dp0.."

set "ENVIRONMENT_NAME=%~1"
set "VALID_NAME="
for %%E in (dev staging prod) do if "%ENVIRONMENT_NAME%"=="%%E" set "VALID_NAME=1"
if not defined VALID_NAME goto :usage

if not exist "secrets\" goto :no_secrets_folder

set "SOURCE_DIR=secrets\%ENVIRONMENT_NAME%"
if not exist "%SOURCE_DIR%\" (
    echo error: %SOURCE_DIR%\ not found. Ask the project owner for an updated secrets\ folder. 1>&2
    exit /b 1
)

rem Files read from the environment folder. When the setup needs another file, add
rem it to this list, to the remove list and the copy lines below, and to use-env.sh.
rem Check everything before writing anything, so a failure never leaves the files
rem of two environments mixed.
for %%F in (secrets.properties google-services.json) do (
    if not exist "%SOURCE_DIR%\%%F" (
        echo error: %SOURCE_DIR%\%%F not found. 1>&2
        exit /b 1
    )
)
findstr /r /c:"^[ 	]*ENVIRONMENT[ 	=:]" "%SOURCE_DIR%\secrets.properties" >nul && (
    echo error: remove the ENVIRONMENT line from %SOURCE_DIR%\secrets.properties: this script sets it from the folder name. 1>&2
    exit /b 1
)

rem Remove the files of the previous environment before writing the new ones. If a
rem write then fails, a file is missing and the build stops, instead of running on
rem the files of two environments.
for %%F in ("secrets.properties" "app\google-services.json") do (
    if exist %%F del /f /q %%F
    if exist %%F (
        echo error: cannot remove %%~F. 1>&2
        exit /b 1
    )
)

(
    echo # Generated by scripts\use-env.bat from %SOURCE_DIR%\. Do not edit: change that folder and run the script again.
    echo ENVIRONMENT=%ENVIRONMENT_NAME%
    type "%SOURCE_DIR%\secrets.properties"
) >"secrets.properties" || exit /b 1
copy /y "%SOURCE_DIR%\google-services.json" "app\google-services.json" >nul || exit /b 1

echo Environment set to '%ENVIRONMENT_NAME%'. Sync Gradle in Android Studio before the next build.
exit /b 0

:no_secrets_folder
echo error: secrets\ not found. Ask the project owner for it and put it in the repository root. 1>&2
exit /b 1

:usage
echo error: usage: scripts\use-env.bat ^<dev^|staging^|prod^> 1>&2
exit /b 1
