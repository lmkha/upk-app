# Copy this file to secrets.properties (git-ignored) and fill in the values of the
# environment you want to build. To build another environment, replace the values.
# Every key becomes a BuildConfig field in the modules that apply the secrets plugin.
#
# This file lists key names only. Never put real values here.

# Which environment these values belong to: dev, staging or prod. Mandatory.
# It decides the applicationId (.dev / .staging / none), the version suffix and the app name.
ENVIRONMENT=

# Base URL of the backend API, for example "https://api.example.com/".
API_URL=
